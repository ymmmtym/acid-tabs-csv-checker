{
  "name": "acid-tabs-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Acid Tabs の CSV 設定を保存せずに検証するローカル Web アプリ",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "docker:build": "docker build -t acid-tabs-checker .",
    "docker:run": "docker run --rm -p 8080:8080 -e HOST=0.0.0.0 -e PORT=8080 acid-tabs-checker",
    "docker:up": "docker compose up --build"
  },
  "engines": {
    "node": ">=20"
  }
}
